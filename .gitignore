# ─────────────────────────────────────────────
# VComm — repository .gitignore
# See README §13 (Migration) — credentials must NEVER be committed.
# ─────────────────────────────────────────────

# Node / npm
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.npm
.yarn/

# Environment files (secrets) — keep only *.example committed
.env
.env.local
.env.*.local
.env.development
.env.production
.env.test

# Legacy AWS credentials — see README §13
mendi_credentials.csv
*.pem
*.key
aws-exports.js

# Build output
build/
dist/
out/
.next/
.cache/
.parcel-cache/

# Coverage / test reports
coverage/
.nyc_output/
*.lcov
junit.xml

# Logs
logs/
*.log

# IDE / editor
.vscode/
.idea/
*.swp
*.swo
*.iml
.DS_Store
Thumbs.db

# OS
desktop.ini
$RECYCLE.BIN/

# PostgreSQL local dumps
*.sql.bak
*.dump
pgdata/

# Misc
.tmp/
tmp/
*.tsbuildinfo
